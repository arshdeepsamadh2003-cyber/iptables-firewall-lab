*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# Allow loopback
-A INPUT -i lo -j ACCEPT

# Block malicious attacker
-A INPUT -s 172.16.1.200 -j DROP
-A FORWARD -s 172.16.1.200 -j DROP

# Allow established connections
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# LAN to DMZ
-A FORWARD -i eth1 -o eth2 -s 10.1.1.0/24 -d 192.168.10.0/24 -j ACCEPT

# LAN to WAN
-A FORWARD -i eth1 -o eth3 -s 10.1.1.0/24 -d 172.16.1.0/24 -j ACCEPT
-A FORWARD -i eth1 -o eth4 -s 10.1.1.0/24 -d 172.16.1.0/24 -j ACCEPT

# WAN to DMZ HTTP
-A FORWARD -i eth3 -o eth2 -s 172.16.1.0/24 -d 192.168.10.10 -p tcp --dport 80 -j ACCEPT

# WAN to DMZ HTTPS
-A FORWARD -i eth3 -o eth2 -s 172.16.1.0/24 -d 192.168.10.10 -p tcp --dport 443 -j ACCEPT

COMMIT
